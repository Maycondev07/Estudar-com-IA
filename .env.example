# Copie este arquivo para ".env.local" e preencha os valores para testar localmente.
# Na Vercel, adicione essas mesmas variáveis em Project Settings > Environment Variables.

# --- Google Gemini (padrão já configurado no código) ---
# Gere a chave de graça em https://aistudio.google.com/apikey (tem plano gratuito
# com limite de requisições por minuto/dia, sem precisar de cartão de crédito).
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_MODEL=gemini-3.6-flash
AI_API_KEY=coloque_sua_chave_aqui

# --- Para usar Groq em vez do Gemini, troque para: ---
# AI_API_BASE_URL=https://api.groq.com/openai/v1
# AI_API_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=coloque_sua_chave_aqui

# --- Para usar DeepSeek em vez do Gemini, troque para: ---
# AI_API_BASE_URL=https://api.deepseek.com
# AI_API_MODEL=deepseek-chat
# AI_API_KEY=coloque_sua_chave_aqui

# --- Para usar Qwen (Alibaba) em vez do Gemini, troque para: ---
# AI_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_API_MODEL=qwen-plus
# AI_API_KEY=coloque_sua_chave_aqui

# --- Para usar Kimi (Moonshot) ---
# AI_API_BASE_URL=https://api.moonshot.cn/v1
# AI_API_MODEL=moonshot-v1-8k
# AI_API_KEY=coloque_sua_chave_aqui

